\item https://stefvanbuuren.name/fimd/sec-pooling.html
\item https://link.springer.com/article/10.1007/s10198-008-0129-y
\item https://bmcmedresmethodol.biomedcentral.com/articles/10.1186/s12874-015-0048-4
}
